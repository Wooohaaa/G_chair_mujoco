name: verify

on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  code-chain:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Install Python deps
        run: |
          python -m pip install --upgrade pip
          python -m pip install -r G_chair_mujoco/requirements.txt
      - name: Regression tests (80 cases)
        run: |
          python tests/test_chain.py
          python tests/test_robustness.py
          python tests/test_protocol.py
          python tests/test_web.py
      - name: Host self-check
        run: python host_app.py --check
      - name: MuJoCo mechanism validation
        working-directory: G_chair_mujoco
        run: python sim.py --validate
      - name: Firmware logic sim
        run: python G_chair_esp32/tests/firmware_sim.py
      - name: Full numerical chain
        run: python tools/full_chain_sim.py
      - name: Vision node mock
        run: |
          python G_chair_vision/screen_telemetry.py --mock --ip 127.0.0.1 --duration 2 --hz 20
          python G_chair_vision/screen_telemetry.py --mock --fast --proc-size 256x144 --ip 127.0.0.1 --duration 2 --hz 20
